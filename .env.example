# Vanyshe Environment Variables Example
# Duplicate to .env.local for local development.

# Admin Console Authentication
ADMIN_PASSWORD=vanyshe-founder-2026
ADMIN_SECRET=your_32_character_random_admin_session_secret_key_here

# App URL
NEXT_PUBLIC_APP_URL=https://vanyshe.com

# Optional STUN / TURN Configuration (RFC 5766)
# Standard Google and Cloudflare STUN servers are used by default.
# If deploying a custom Coturn / Metered / Twilio TURN service:
# TURNSERVER_URL=turn:turn.vanyshe.com:3478
# TURNSERVER_USERNAME=vanyshe_user
# TURNSERVER_CREDENTIAL=vanyshe_secret
